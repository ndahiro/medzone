# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# No browser-side PHI key exists. Visit transcripts are encrypted at rest by the
# API under PHI_ENCRYPTION_KEY (server-only), and the browser receives plaintext
# over TLS for the visits the caller may read. Do not reintroduce a VITE_ PHI
# key: anything prefixed VITE_ ships inside the public bundle, so it cannot
# protect stored PHI.

# MFA_REQUIRED: require a second factor on every signed-in session. Each account
# enrolls its OWN authenticator (Security → MFA); the server stores that secret
# encrypted with PHI_ENCRYPTION_KEY and keeps a single-use ledger per account, so
# a code proves possession for that account only. An account that has not
# enrolled is refused with MFA_ENROLLMENT_REQUIRED.
MFA_REQUIRED="false"

# MFA_TOTP_SECRET: DEPRECATED. A deployment-wide shared secret used to verify
# every account, which meant any holder could satisfy MFA for any user. Setting
# it now only turns enforcement on; its value is no longer accepted as a code.
# Use MFA_REQUIRED instead.
MFA_TOTP_SECRET=""

# --- Backend API (server.js) -------------------------------------------------

# PORT: Port the Express API listens on. The Vite dev server proxies /api here.
PORT="3001"

# MySQL connection. Defaults match the docker-compose.yml service.
DB_HOST="127.0.0.1"
DB_PORT="3307"
DB_USER="medzone"
DB_PASSWORD="medzone"
DB_NAME="medzone"

# --- Concurrency tuning (50+ pairs / 100 concurrent users) -------------------
#
# Steady-state load with 50 pairs live (jittered client tickers):
#   signaling poll  100 users / 1.5s  ≈ 65 req/s
#   chat ticker     100 users / 3s    ≈ 33 req/s
#   waiting room    50 stations / 15s ≈  4 req/s
#   vitals ticker   100 rooms / 15s   ≈  7 req/s
# One bootstrap costs ~10 pooled queries. Size for PEAK concurrent users:
#   DB_POOL_SIZE x WORKERS < MySQL max_connections (compose sets 300).
# Recommended for 50 pairs: WORKERS=4 + DB_POOL_SIZE=25 (100 connections),
# which spreads bcrypt/PBKDF2 CPU across cores. The single-process default
# still works but queues deeper under a synchronized login burst.
WORKERS="1"
DB_POOL_SIZE="25"
DB_CONNECT_TIMEOUT_MS="10000"

# Session subject cache: how long a resolved RBAC user row is reused.
# sessionSubject runs on EVERY authenticated request (~110 req/s at 50 pairs),
# so a short cache avoids a users-table lookup per poll. Admin revokes land
# within this window. 0 disables the cache (fresh read every request).
SESSION_SUBJECT_TTL_MS="5000"

# Bootstrap payload caps: staff logins serialize at most this many visits /
# transcript messages. A clinic with hundreds of rows must not dump the whole
# table into every one of 100 near-simultaneous logins.
BOOTSTRAP_APPOINTMENT_CAP="200"
BOOTSTRAP_MESSAGE_CAP="100"

# Providers list cache: near-static reference data served from memory for
# this long between MySQL re-reads. Lower it if providers change often.
PROVIDERS_CACHE_TTL_MS="30000"

# Login brute-force guard: max attempts per IP per window (bcrypt is
# CPU-bound, so bursts here would stall the event loop). Raised for the 50-pair
# tier: a clinic-wide burst signs in ~100 sessions inside one window.
LOGIN_RATE_WINDOW_MS="60000"
LOGIN_RATE_MAX="300"

# Per-account failed-login guard, independent of the caller's IP. Stops a
# distributed attack from staying under every per-IP budget while hammering one
# account. A successful sign-in clears the account's budget immediately.
LOGIN_ACCOUNT_RATE_WINDOW_MS="60000"
LOGIN_ACCOUNT_RATE_MAX="20"

# Comma-separated extra origins allowed to send unsafe API requests (CSRF
# defense). Same-host requests are always allowed; list the full origin
# (scheme + host + port) for a native client or a separately hosted frontend.
# ALLOWED_ORIGINS="https://app.example.org"

# Consultation transcript guard: max encrypted messages per IP per window.
# Room admission itself is participant-checked by the API.
CHAT_RATE_WINDOW_MS="60000"
CHAT_RATE_MAX="120"

# Transcript read guard (live-sync ticker): max transcript reads per IP per
# window. 50 pairs poll every ~3s ≈ 2,000 reads/min clinic-wide.
TRANSCRIPT_READ_RATE_WINDOW_MS="60000"
TRANSCRIPT_READ_RATE_MAX="120"

# WebRTC signaling guard (poll + heartbeat while a room is live): max relay
# requests per account per window. One live user ≈ 45 req/min steady state;
# the default below holds that plus ICE-trickle bursts at join.
SIGNAL_RATE_WINDOW_MS="60000"
SIGNAL_RATE_MAX="200"

# PHI write guard: one shared per-account budget for the endpoints that insert
# rows a client can repeat without bound — bookings, consultation requests,
# referrals, guest invites and in-visit attachments. Human use is a handful of
# writes per visit, so the default leaves ample room while bounding a runaway
# tab or a stolen session.
PHI_WRITE_RATE_WINDOW_MS="60000"
PHI_WRITE_RATE_MAX="60"

# PHI derived-key cache: max cached PBKDF2 keys for field decryption.
# Repeat bootstrap reads hit the cache instead of re-running 600k iterations.
PHI_KEY_CACHE_MAX="1000"

# PHI_ENCRYPTION_KEY: PBKDF2 passphrase used to encrypt SOAP narrative fields
# before they are written to MySQL. REQUIRED in production; a development
# fallback is used when unset outside NODE_ENV=production.
PHI_ENCRYPTION_KEY="MY_SERVER_PHI_ENCRYPTION_KEY"

# --- RBAC user management (mirrors the elgon pattern) ------------------------

# JWT_SECRET: signs the httpOnly session cookie. REQUIRED in production; a
# development fallback is used when unset outside NODE_ENV=production.
JWT_SECRET="MY_JWT_SECRET_CHANGE_ME"

# Initial administrator seeded when the users table has no admin yet.
ADMIN_USERNAME="admin"
ADMIN_DISPLAY_NAME="Administrator"
ADMIN_PASSWORD="Admin123"

# --- Patient invitation links (HCW@Home parity) ------------------------------

# INVITE_TTL_HOURS: how long a single-click patient invitation link stays valid.
# Re-issuing a link supersedes the visit's previous one, so a leaked token has
# at most this window to be used.
INVITE_TTL_HOURS="72"

# --- S2S voice bridge (Crane AI Labs first) ---------------------------------
# Opt-in speech-to-speech for video visits, Uganda-languages first. The API
# proxies ephemeral audio to YOUR OWN self-hosted endpoints — the browser
# never holds vendor keys and raw audio is never persisted.
# S2S_PROVIDER: off (default) | crane. Crane STT needs a self-hosted
#   crane-nemo-asr-1.2 endpoint (NeMo/Triton/Faster-Whisper front-end):
#   S2S_PROVIDER="crane"
#   CRANE_ASR_URL="http://crane-asr:8000/v1/transcribe"
#   CRANE_ASR_MODEL defaults to CraneAILabs/crane-nemo-asr-1.2
#   (Luganda WER 17.9%, Swahili 22.3%, Shona, English retention).
# CRANE_ASR_API_KEY: bearer token for the ASR endpoint (optional).
# CRANE_MT_URL / CRANE_MT_API_KEY: optional translation leg
#   (NLLB-style Luganda↔English etc). Unset = transcript passes through.
# CRANE_TTS_URL / CRANE_TTS_API_KEY: optional synthesis leg.
#   Unset = the browser speaks the translation via speechSynthesis.
# S2S_TIMEOUT_MS: per-leg fetch timeout. S2S_MAX_AUDIO_BYTES: max turn size.
# S2S_RATE_WINDOW_MS / S2S_RATE_MAX: per-user turn budget (default 30/min).
#S2S_PROVIDER="off"
#CRANE_ASR_URL="http://localhost:8000/v1/transcribe"
#CRANE_ASR_MODEL="CraneAILabs/crane-nemo-asr-1.2"
#CRANE_MT_URL="http://localhost:8001/v1/translate"
#CRANE_TTS_URL="http://localhost:8002/v1/synthesize"
#S2S_TIMEOUT_MS="15000"
#S2S_MAX_AUDIO_BYTES="1500000"
#S2S_RATE_WINDOW_MS="60000"
#S2S_RATE_MAX="30"
